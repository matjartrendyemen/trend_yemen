# Trend Yemen - example runtime environment
# Copy this file to `.env` locally and fill real values.
# Do NOT commit real secrets.

GEMINI_API_KEY=
SPREADSHEET_ID=
DRIVE_FOLDER_ID=

CJ_API_KEY=
CJ_EMAIL=
CJ_PASSWORD=

PEXELS_API_KEY=
PIXABAY_API_KEY=

# Option A:
# Put the raw one-line Google service account JSON into GOOGLE_CREDENTIALS
# if your runtime uses env-based credentials loading.
GOOGLE_CREDENTIALS=

# Option B:
# For the current local Windows fallback runtime, GOOGLE_CREDENTIALS is loaded
# from `trend-yemen-service.json` by the local PowerShell startup script instead.
# In that case, keep GOOGLE_CREDENTIALS empty here.
