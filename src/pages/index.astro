---
import ProductCard from '../components/ProductCard.astro';

const products=[
{
sku:"TY-1",
title:"ساعة ذكية",
price_yer:15000,
imageUrl:"https://images.pexels.com/photos/437037/pexels-photo-437037.jpeg"
},
{
sku:"TY-2",
title:"سماعات بلوتوث",
price_yer:18000,
imageUrl:"https://images.pexels.com/photos/3394650/pexels-photo-3394650.jpeg"
}
];
---

<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<title>Trend Yemen Store</title>
</head>

<body>

<h1 style="text-align:center">متجر ترند اليمن</h1>

<div class="grid">
{products.map(p => (
<ProductCard product={p} />
))}
</div>

<style>
body{
font-family:sans-serif;
background:#f6f6f6;
}

.grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
gap:20px;
padding:40px;
}
</style>

</body>
</html>
