---
const API_BASE = "https://trendyemen-production.up.railway.app";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Admin Overview</title>
    <style>
      body {
        font-family: Arial;
        background: #0b1020;
        color: white;
        padding: 20px;
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
        gap: 16px;
      }

      .card {
        background: #121a2b;
        padding: 16px;
        border-radius: 12px;
      }

      .badge {
        padding: 4px 10px;
        border-radius: 10px;
        font-size: 12px;
      }

      .ready { background: green; }
      .needs_review { background: orange; }
      .invalid { background: red; }

      img {
        width: 100%;
        height: 150px;
        object-fit: cover;
        margin-top: 10px;
      }
    </style>
  </head>

  <body>
    <h1>Admin Overview</h1>

    <div id="app">Loading...</div>

    <script>
      async function load() {
        const res = await fetch(`${API_BASE}/admin/overview`);
        const data = await res.json();

        const html = data.map(r => {
          const status = r.readiness?.status || "unknown";
          const missing = r.smart_encoding_inputs?.missing_fields || [];

          return `
            <div class="card">
              <h3>${r.product_name || "No name"}</h3>

              <div>Category: ${r.category_id || "-"}</div>

              <div class="badge ${status}">
                ${status}
              </div>

              <img src="${r.final_image_url || r.source_image_url || ""}" />

              <div>
                ${missing.length ? missing.join(", ") : "No missing fields"}
              </div>
            </div>
          `;
        }).join("");

        document.getElementById("app").innerHTML =
          `<div class="grid">${html}</div>`;
      }

      load();
    </script>
  </body>
</html>
