---
import ProductCard from '../components/ProductCard.astro';
import FloatingCart from '../components/FloatingCart.astro';
const products =;
---
<html lang="ar" dir="rtl">
<head><meta charset="utf-8" /><title>متجر ترند اليمن</title></head>
<body style="margin:0; font-family:sans-serif; background:#f8f9fa; user-select:none;">
  <header style="text-align:center; padding:40px; background:#111; color:#d4af37;"><h1>ترند اليمن</h1></header>
  <main style="max-width:1200px; margin:0 auto; padding:20px;">
    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(250px, 1fr)); gap:25px;">
      {products.map(p => <ProductCard product={p} />)}
    </div>
  </main>
  <FloatingCart />
</body>
</html>
