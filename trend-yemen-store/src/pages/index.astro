---
import ProductCard from '../components/ProductCard.astro';
import FloatingCart from '../components/FloatingCart.astro';

const products =;
---
<html lang="ar" dir="rtl">
<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>متجر ترند اليمن</title><link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700;800&display=swap" rel="stylesheet"></head>
<body style="margin:0; font-family:'Cairo', sans-serif; background:#f8f9fa; user-select:none;">
  <header style="text-align:center; padding:40px; background:#111; color:#d4af37;">
    <h1 style="margin:0; font-size:2.5rem;">ترند اليمن</h1>
    <p style="color:#ccc;">أحدث المنتجات بأسعار لا تقبل المنافسة لعام 2026</p>
  </header>
  <main style="max-width:1200px; margin:0 auto; padding:40px 20px;">
    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(240px, 1fr)); gap:25px;">
      {products.map((p) => <ProductCard product={p} />)}
    </div>
  </main>
  <FloatingCart />
</body>
</html>
