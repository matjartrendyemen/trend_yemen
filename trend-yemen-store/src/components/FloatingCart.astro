---
const WHATSAPP_NUMBER = "967777549269";
---
<div id="cart-bubble" class="cart-bubble">
  <span class="cart-count" id="cart-count">0</span>🛒
</div>

<div id="cart-modal" class="cart-modal hidden">
  <div class="cart-header"><h3>سلة المشتريات</h3><button id="close-cart">×</button></div>
  <div id="cart-items" class="cart-items"></div>
  <div class="cart-footer">
    <div class="total">الإجمالي: <span id="cart-total">0</span> ر.ي</div>
    <button id="checkout-btn" class="checkout-btn">الطلب عبر واتساب 💬</button>
  </div>
</div>

<script define:vars={{ WHATSAPP_NUMBER }}>
  let cart = JSON.parse(localStorage.getItem('ty_cart')) ||;
  
  const updateCartUI = () => {
    const countEl = document.getElementById('cart-count');
    const itemsEl = document.getElementById('cart-items');
    const totalEl = document.getElementById('cart-total');
    if (!countEl ||!itemsEl ||!totalEl) return;

    countEl.innerText = cart.length;
    let total = 0;
    
    if(cart.length === 0) {
        itemsEl.innerHTML = '<p style="text-align:center; padding:20px; color:#888;">السلة فارغة</p>';
    } else {
        itemsEl.innerHTML = cart.map((item, index) => {
            total += item.price;
            return `<div style="display:flex; justify-content:space-between; padding:10px; border-bottom:1px solid #eee; font-size:0.9rem;">
                      <span>${item.title}</span>
                      <span>${item.price} ر.ي</span>
                    </div>`;
        }).join('');
    }
    totalEl.innerText = total;
    localStorage.setItem('ty_cart', JSON.stringify(cart));
  };

  window.addToCart = (sku, title, price) => {
    cart.push({ sku, title, price });
    updateCartUI();
    const bubble = document.getElementById('cart-bubble');
    bubble.style.transform = 'scale(1.2)';
    setTimeout(() => bubble.style.transform = 'scale(1)', 200);
  };

  document.getElementById('cart-bubble').onclick = () => document.getElementById('cart-modal').classList.toggle('hidden');
  document.getElementById('close-cart').onclick = () => document.getElementById('cart-modal').classList.add('hidden');
  
  document.getElementById('checkout-btn').onclick = () => {
    if (cart.length === 0) return alert('السلة فارغة!');
    let msg = "طلب جديد من متجر ترند اليمن:\n\n" + cart.map(i => `- ${i.title} | ${i.price} ر.ي`).join('\n');
    window.open(`https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(msg)}`, '_blank');
  };

  updateCartUI();
</script>

<style>
 .cart-bubble { position: fixed; bottom: 30px; left: 30px; width: 60px; height: 60px; background: #d4af37; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 24px; cursor: pointer; z-index: 1000; box-shadow: 0 10px 20px rgba(212,175,55,0.4); transition: transform 0.3s ease; }
 .cart-count { position: absolute; top: -5px; right: -5px; background: #111; color: #fff; font-size: 12px; width: 22px; height: 22px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold; }
 .cart-modal { position: fixed; bottom: 100px; left: 30px; width: 300px; background: #fff; border-radius: 16px; box-shadow: 0 15px 40px rgba(0,0,0,0.15); z-index: 1000; display: flex; flex-direction: column; overflow: hidden; direction: rtl; font-family: sans-serif; }
 .cart-modal.hidden { display: none; }
 .cart-header { background: #111; color: #fff; padding: 15px; display: flex; justify-content: space-between; align-items: center; }
 .cart-header h3 { margin: 0; font-size: 1rem; }
 .cart-header button { background: none; border: none; color: #fff; font-size: 20px; cursor: pointer; }
 .cart-items { max-height: 250px; overflow-y: auto; }
 .cart-footer { padding: 15px; background: #f9f9f9; border-top: 1px solid #eee; }
 .total { font-weight: bold; margin-bottom: 10px; }
 .checkout-btn { width: 100%; padding: 10px; background: #25D366; color: #fff; border: none; border-radius: 8px; font-weight: bold; cursor: pointer; }
</style>
