---
const WHATSAPP_NUMBER = "967777549269";
---
<div id="cart-bubble" class="bubble"><span id="cart-count">0</span>🛒</div>
<div id="cart-modal" class="modal hidden">
  <div class="header"><h3>سلة المشتريات</h3><button id="close-cart">×</button></div>
  <div id="cart-items"></div>
  <div class="footer">
    <div class="total">الإجمالي: <span id="cart-total">0</span> ر.ي</div>
    <button id="checkout-btn" class="checkout">الطلب عبر واتساب 💬</button>
  </div>
</div>
<script define:vars={{ WHATSAPP_NUMBER }}>
  document.addEventListener('contextmenu', e => e.preventDefault());
  document.addEventListener('dragstart', e => e.preventDefault());
  let cart = JSON.parse(localStorage.getItem('ty_cart')) ||;
  const updateUI = () => {
    document.getElementById('cart-count').innerText = cart.length;
    let total = 0;
    const itemsEl = document.getElementById('cart-items');
    itemsEl.innerHTML = cart.map(i => {
      total += i.price;
      return `<div style="display:flex; justify-content:space-between; padding:10px; border-bottom:1px solid #eee;"><span>${i.title}</span><span>${i.price} ر.ي</span></div>`;
    }).join('');
    document.getElementById('cart-total').innerText = total;
    localStorage.setItem('ty_cart', JSON.stringify(cart));
  };
  window.addToCart = (sku, title, price) => { cart.push({sku, title, price}); updateUI(); };
  document.getElementById('cart-bubble').onclick = () => document.getElementById('cart-modal').classList.toggle('hidden');
  document.getElementById('checkout-btn').onclick = () => {
    let msg = "طلب جديد من ترند اليمن:\n" + cart.map(i => `- ${i.title}`).join('\n');
    window.open(`https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(msg)}`);
  };
  updateUI();
</script>
<style>
.bubble { position:fixed; bottom:30px; left:30px; width:60px; height:60px; background:#d4af37; border-radius:50%; display:flex; align-items:center; justify-content:center; cursor:pointer; z-index:1000; box-shadow:0 10px 20px rgba(0,0,0,0.1); }
.modal { position:fixed; bottom:100px; left:30px; width:300px; background:#fff; border-radius:16px; box-shadow:0 15px 40px rgba(0,0,0,0.15); z-index:1000; direction:rtl; }
.modal.hidden { display:none; }
.checkout { width:100%; padding:10px; background:#25D366; color:#fff; border:none; border-radius:8px; font-weight:bold; cursor:pointer; }
</style>
