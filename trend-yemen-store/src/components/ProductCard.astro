---
const { product } = Astro.props;
---
<div class="product-card">
  <div class="image-wrapper">
    <div class="protection-overlay"></div>
    <img src={product.imageUrl} alt={product.title} loading="lazy" />
  </div>
  <div class="card-body">
    <span class="sku">{product.sku}</span>
    <h3 class="title">{product.title}</h3>
    <div class="price-row">
      <span class="price">{product.price_yer} ر.ي</span>
      <button class="cart-btn" onclick={`addToCart('${product.sku}', '${product.title}', ${product.price_yer})`}>🛒</button>
    </div>
  </div>
</div>

<style>
.product-card {
    background: #fff; border-radius: 16px; overflow: hidden;
    box-shadow: 0 10px 30px rgba(0,0,0,0.05); transition: 0.4s ease;
    display: flex; flex-direction: column; height: 100%;
  }
.product-card:hover { transform: translateY(-10px); box-shadow: 0 20px 40px rgba(0,0,0,0.12); }
.image-wrapper { position: relative; aspect-ratio: 1 / 1; overflow: hidden; }
.image-wrapper img { width: 100%; height: 100%; object-fit: cover; transition: 0.6s ease; }
.product-card:hover.image-wrapper img { transform: scale(1.08); }
.protection-overlay { position: absolute; top: 0; left: 0; right: 0; bottom: 0; z-index: 10; }
.card-body { padding: 20px; display: flex; flex-direction: column; flex-grow: 1; }
.sku { font-size: 0.7rem; color: #888; }
.title { font-size: 1rem; font-weight: 700; color: #111; margin: 5px 0 15px 0; line-height: 1.4; }
.price-row { margin-top: auto; display: flex; justify-content: space-between; align-items: center; }
.price { font-size: 1.2rem; font-weight: 800; color: #d4af37; }
.cart-btn { background: #111; color: #fff; border: none; border-radius: 50%; width: 40px; height: 40px; cursor: pointer; transition: 0.3s; z-index: 20; }
.cart-btn:hover { background: #d4af37; transform: scale(1.1); }
</style>
