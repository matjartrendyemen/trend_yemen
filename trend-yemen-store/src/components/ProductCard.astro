---
const { product } = Astro.props;
---
<div class="product-card">
  <div class="image-box">
    <div class="protection-overlay"></div>
    <img src={product.imageUrl} alt={product.title} loading="lazy" />
  </div>
  <div class="card-content">
    <span class="sku">{product.sku}</span>
    <h3>{product.title}</h3>
    <div class="price-row">
      <span class="price">{product.price_yer} ر.ي</span>
      <button class="buy-btn" onclick={`addToCart('${product.sku}', '${product.title}', ${product.price_yer})`}>🛒</button>
    </div>
  </div>
</div>
<style>
.product-card { background:#fff; border-radius:16px; overflow:hidden; box-shadow:0 10px 30px rgba(0,0,0,0.05); transition:.4s ease; display:flex; flex-direction:column; height:100%; }
.product-card:hover { transform:translateY(-10px); }
.image-box { position:relative; aspect-ratio:1/1; overflow:hidden; }
.image-box img { width:100%; height:100%; object-fit:cover; }
.protection-overlay { position:absolute; top:0; left:0; right:0; bottom:0; z-index:10; }
.card-content { padding:20px; flex-grow:1; }
.sku { font-size:0.7rem; color:#888; }
.price { font-size:1.25rem; font-weight:800; color:#d4af37; }
.buy-btn { background:#111; color:#fff; border:none; border-radius:50%; width:40px; height:40px; cursor:pointer; z-index:20; }
</style>
