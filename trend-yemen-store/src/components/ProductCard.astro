---
const { product } = Astro.props;
---
<div class="product-card" data-product={JSON.stringify(product)}>
  <div class="card-image-wrapper">
    <div class="protection-overlay"></div>
    <img src={product.imageUrl} alt={product.title} loading="lazy" />
  </div>
  <div class="card-content">
    <span class="sku-label">{product.sku}</span>
    <h3 class="title">{product.title}</h3>
    <div class="price-row">
      <span class="price">{product.price_yer} ر.ي</span>
      <button class="add-to-cart-btn" onclick={`addToCart('${product.sku}', '${product.title}', ${product.price_yer})`}>
        🛒
      </button>
    </div>
  </div>
</div>

<style>
 .product-card {
    background: #fff; border-radius: 16px; overflow: hidden;
    box-shadow: 0 10px 30px rgba(0,0,0,0.05); transition: 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    position: relative; display: flex; flex-direction: column; height: 100%;
  }
 .product-card:hover { transform: translateY(-10px); box-shadow: 0 20px 40px rgba(0,0,0,0.12); }
 .card-image-wrapper { position: relative; width: 100%; aspect-ratio: 1 / 1; overflow: hidden; }
 .card-image-wrapper img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease; }
 .product-card:hover.card-image-wrapper img { transform: scale(1.08); }
 .protection-overlay { position: absolute; top: 0; left: 0; right: 0; bottom: 0; z-index: 10; pointer-events: all; }
 .card-content { padding: 20px; display: flex; flex-direction: column; flex-grow: 1; }
 .sku-label { font-size: 0.7rem; color: #888; text-transform: uppercase; margin-bottom: 5px; }
 .title { font-size: 1rem; font-weight: 700; color: #111; margin: 0 0 15px 0; line-height: 1.4; }
 .price-row { margin-top: auto; display: flex; justify-content: space-between; align-items: center; }
 .price { font-size: 1.1rem; font-weight: 800; color: #d4af37; }
 .add-to-cart-btn {
    background: #111; color: #fff; border: none; border-radius: 50%;
    width: 35px; height: 35px; cursor: pointer; transition: 0.3s; z-index: 20;
  }
 .add-to-cart-btn:hover { background: #d4af37; transform: scale(1.1); }
</style>
