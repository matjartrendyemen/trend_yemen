---
const { product } = Astro.props;
---
<div class="product-card" data-product={JSON.stringify(product)}>
  <div class="card-image-wrapper">
    <div class="protection-overlay"></div>
    <img src={product.imageUrl} alt={product.title} loading="lazy" />
  </div>
  <div class="card-content">
    <span class="category">{product.sku}</span>
    <h3 class="title">{product.title}</h3>
    <div class="price-row">
      <span class="price">{product.price_yer} ر.ي</span>
      <button class="add-to-cart-btn" onclick={`addToCart('${product.sku}', '${product.title}', ${product.price_yer})`}>
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
      </button>
    </div>
  </div>
</div>

<style>
.product-card {
    background: #fff; border-radius: 16px; overflow: hidden;
    box-shadow: 0 10px 30px rgba(0,0,0,0.05); transition:.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    position: relative; display: flex; flex-direction: column;
  }
.product-card:hover { transform: translateY(-10px); box-shadow: 0 20px 40px rgba(0,0,0,0.12); }
.card-image-wrapper { position: relative; width: 100%; aspect-ratio: 1/1; overflow: hidden; }
.card-image-wrapper img { width: 100%; height: 100%; object-fit: cover; transition: transform.6s ease; }
.product-card:hover.card-image-wrapper img { transform: scale(1.08); }
.protection-overlay { position: absolute; top:0; left:0; right:0; bottom:0; z-index: 10; pointer-events: all; }
.card-content { padding: 20px; display: flex; flex-direction: column; flex-grow: 1; }
.category { font-size: 0.75rem; color: #888; text-transform: uppercase; margin-bottom: 8px; }
.title { font-size: 1.1rem; font-weight: 700; color: #111; margin: 0 0 15px 0; line-height: 1.4; }
.price-row { margin-top: auto; display: flex; justify-content: space-between; align-items: center; }
.price { font-size: 1.25rem; font-weight: 800; color: #d4af37; }
.add-to-cart-btn { background: #111; color: #fff; border: none; border-radius: 50%; width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; cursor: pointer; transition:.3s; z-index: 20; }
.add-to-cart-btn:hover { background: #d4af37; transform: scale(1.1); }
</style>
